# AnvithBizCap — Next.js production env example
# Copy to .env (local dev) or to /root/anvithbizcap-website.env (VPS).
# .env is gitignored — never commit secrets.

# Prisma datasource. Default SQLite file relative to project root.
# In production we point this at a persistent path outside the deploy tree
# so deploys never overwrite the DB.
DATABASE_URL="file:./dev.db"

# JWT signing key for admin sessions. 64-char random hex is plenty.
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"

# Optional: explicit port if not using Next.js default (3000).
# PORT=3010

# Optional: cookies need to know the public origin in some flows.
# NEXTAUTH_URL=https://anvithbizcap.com
