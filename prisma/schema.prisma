generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model MFScheme {
  id                   Int      @id @default(autoincrement())
  schemeName           String
  expenseRatio         Float?
  category             String?
  aumCr                Float?
  return1Day           Float?
  return7Day           Float?
  return15Day          Float?
  return30Day          Float?
  return3Month         Float?
  return6Month         Float?
  return1Year          Float?
  return2Year          Float?
  return3Year          Float?
  return5Year          Float?
  return7Year          Float?
  return10Year         Float?
  return15Year         Float?
  return20Year         Float?
  return25Year         Float?
  returnSinceInception Float?
  fundRating           String?
  alpha                Float?
  beta                 Float?
  mean                 Float?
  standardDev          Float?
  sharpeRatio          Float?
  sortinoRatio         Float?
  avgMaturity          Float?
  modifiedDuration     Float?
  yieldToMaturity      Float?
  launchDate           String?
  benchmark            String?
  largecapRatio        Float?
  midcapRatio          Float?
  smallcapRatio        Float?
  equityPercent        Float?
  debtPercent          Float?
  goldPercent          Float?
  globalEquityPercent  Float?
  otherPercent         Float?
  currentNav           Float?
  isRecommended        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MFDataMeta {
  id        Int      @id @default(autoincrement())
  navDate   String
  fileName  String
  updatedAt DateTime @updatedAt
}

model Lead {
  id              Int      @id @default(autoincrement())
  name            String
  mobile          String
  email           String
  city            String?
  interestedIn    String?
  investmentRange String?
  message         String?
  source          String   @default("website")
  status          String   @default("new")
  createdAt       DateTime @default(now())
}

model Blog {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String
  author      String    @default("Team AnvithBizCap")
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model News {
  id          Int       @id @default(autoincrement())
  title       String
  excerpt     String
  content     String?
  source      String?
  sourceUrl   String?
  category    String
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  rating    Int      @default(5)
  review    String
  product   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  ctaText   String?
  ctaUrl    String?
  imageUrl  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
